# workflow/Snakefile

# Main entrypoint of the workflow.
# Please follow the best practices:
# https://snakemake.readthedocs.io/en/stable/snakefiles/best_practices.html,
# in particular regarding the standardized folder structure mentioned there.

# import basic packages
# -----------------------------------------------------
import pandas as pd

from snakemake.utils import validate


# load configuration and validate schema
# -----------------------------------------------------
configfile: "config/config.yaml"


validate(config, schema="schemas/config.schema.yaml")


# global wildcard constrains
# -----------------------------------------------------
wildcard_constraints:
    var_type="snp|indel",


# sample Metadata Table Loading & Schema Validation
# ------------------------------------------------------------------------------

samples_df = pd.read_csv(config["samples"], sep="\t")
validate(samples_df, schema="schemas/samples.schema.yaml")

# normalize var_type column to lower case for case-insensitive indexing
samples_df["var_type"] = samples_df["var_type"].str.lower()
SAMPLES = samples_df.set_index(["sample", "var_type"], drop=False)


# load helper functions, data structures, and rule definitions
# -----------------------------------------------------
include: "rules/variant_processing.smk"
include: "rules/phasing.smk"


# optional messages, log and error handling
# -----------------------------------------------------
onstart:
    print("\n--- Analysis started ---\n")


onsuccess:
    print("\n--- Workflow finished! ---\n")


onerror:
    print("\n--- An error occurred! ---\n")


# target rules
# -----------------------------------------------------
rule all:
    default_target: True
    input:
        "results/merged/all_samples.vcf.gz",
        "results/merged/all_samples.vcf.gz.csi",
        expand("results/phasing/split/all_samples_chr{i}.vcf.gz.csi", i=range(1, 23)),
        expand("results/phasing/split/all_samples_chr{i}.vcf.gz.csi", i=range(1, 23)),
