# workflow/rules/haplotype_sequences.smk


rule extract_haplotypes_and_genotypes:
    """
    Extract unique haplotype combinations and generate sample genotype matrices.

    Parses phased VCF files and transcript annotations using pysam to extract
    exonic variants, identify unique haplotypic combinations for each transcript,
    and construct sample genotype mappings across all individual samples.

    :input phased_vcf: Phased VCF file containing genomic variants for a specific chromosome.
    :input annotations: CSV file containing exon-level transcript structural annotations.
    :output haplotypes_csv: Output CSV file detailing unique transcript haplotypes and variant signatures.
    :output genotypes_csv: Output CSV matrix mapping sample genotypes to haplotype identifiers.

    """
    input:
        phased_vcf="results/phasing/phased/{chr}.phased.vcf.gz",
        annotations="resources/reference_data/protein_coding_transcripts.csv",
    output:
        haplotypes_csv=temp(
            "results/haplotype_sequences/haplotypes/{chr}_haplotypes.csv"
        ),
        genotypes_csv=protected(
            "results/haplotype_sequences/genotypes/{chr}_genotypes.csv"
        ),
    log:
        "logs/haplotype_sequences/extract_haplotypes_and_genotypes/{chr}.log",
    benchmark:
        "benchmarks/haplotype_sequences/extract_haplotypes_and_genotypes/{chr}.tsv"
    conda:
        "../envs/haplotype_sequences.yaml"
    threads: 1
    resources:
        mem_mb=7500,
        runtime=30,
    message:
        "Extracting haplotypes and genotypes for chromosome {wildcards.chr}"
    script:
        "../scripts/extract_haplotypes_and_genotypes.py"


rule generate_mutated_sequences:
    """
    Construct mutated coding nucleotide sequences (CDS) for each identified haplotype.

    Applies exonic SNPs, insertions, and deletions defined in the haplotype registry
    to the canonical reference CDS sequences, accounting for 5' UTR start-codon gains
    and 3' UTR stop-loss extensions.

    :input haplotypes_csv: Haplotypes metadata generated by extract_haplotypes_and_genotypes.
    :input wt_cds: Canonical coding sequences retrieved from Ensembl.
    :input annotations: Exonic boundary annotations per transcript.
    :output mutated_cds_csv: Intermediate dataset containing mutated nucleotide sequences.

    """
    input:
        haplotypes_csv="results/haplotype_sequences/haplotypes/{chr}_haplotypes.csv",
        wt_cds="resources/reference_data/wt_cds.csv",
        annotations="resources/reference_data/protein_coding_transcripts.csv",
    output:
        mutated_cds_csv=temp(
            "results/haplotype_sequences/haplotypes/{chr}_haplotypes_nn.csv"
        ),
    log:
        "logs/haplotype_sequences/generate_mutated_sequences/{chr}.log",
    benchmark:
        "benchmarks/haplotype_sequences/generate_mutated_sequences/{chr}.tsv"
    conda:
        "../envs/haplotype_sequences.yaml"
    threads: 4
    resources:
        mem_mb=7500,
        runtime=45,
    message:
        "Generating mutated nucleotide sequences for chromosome {wildcards.chr}"
    script:
        "../scripts/generate_mutated_sequences.py"


rule translate_sequences:
    """
    Translates the mutated coding nucleotide sequences (CDS) into amino acid sequences.

    Processes the intermediate '{chr}_haplotypes_nn.csv' file to translate the 'nn_sequence'
    into 'aa_sequence', identifying any premature stop codons or frameshifts.

    :input mutated_cds_csv: Intermediate dataset containing mutated nucleotide sequences.
    :output mutated_aa_csv: Dataset containing translated amino acid sequences.
    """
    input:
        mutated_cds_csv="results/haplotype_sequences/haplotypes/{chr}_haplotypes_nn.csv",
    output:
        mutated_aa_csv=temp(
            "results/haplotype_sequences/haplotypes/{chr}_haplotypes_aa.csv"
        ),
    log:
        "logs/haplotype_sequences/translate_sequences/{chr}.log",
    benchmark:
        "benchmarks/haplotype_sequences/translate_sequences/{chr}.tsv"
    conda:
        "../envs/haplotype_sequences.yaml"
    threads: 2
    resources:
        mem_mb=4000,
        runtime=30,
    params:
        ncbi_genetic_code=NCBI_GENETIC_CODE,
    message:
        "Translating mutated nucleotide sequences to amino acids for chromosome {wildcards.chr}"
    script:
        "../scripts/translate_sequences.py"


rule compute_frequencies:
    """
    Computes populational haplotype frequencies and separates output deliverables.

    Integrates translated haplotype sequences with the sample genotype matrix
    to calculate the relative frequency percentage ('freq_perc') of each unique
    haplotype across the cohort. Exports a lightweight annotated metadata CSV
    and a dedicated sequence mapping CSV for memory efficiency.

    :input haplotypes: The translated haplotype sequences dataset.
    :input genotypes: Matrix mapping sample genotypes to haplotype identifiers.
    :output haplotypes_annotations: Lightweight haplotype metadata dataset including 'freq_perc'.
    :output haplotypes_sequences: Dedicated CSV file mapping haplotypes to nucleotide and amino acid sequences.

    """
    input:
        haplotypes="results/haplotype_sequences/haplotypes/{chr}_haplotypes_aa.csv",
        genotypes="results/haplotype_sequences/genotypes/{chr}_genotypes.csv",
    output:
        haplotypes_annotations=protected(
            "results/haplotype_sequences/haplotypes/{chr}_haplotypes_annotations.csv"
        ),
        haplotypes_sequences=protected(
            "results/haplotype_sequences/haplotypes/{chr}_haplotypes_sequences.csv"
        ),
    log:
        "logs/haplotype_sequences/compute_frequencies/{chr}.log",
    benchmark:
        "benchmarks/haplotype_sequences/compute_frequencies/{chr}.tsv"
    conda:
        "../envs/haplotype_sequences.yaml"
    threads: 4
    resources:
        mem_mb=4000,
        runtime=20,
    message:
        "Computing populational haplotype frequencies for chromosome {wildcards.chr}"
    script:
        "../scripts/compute_frequencies.py"
